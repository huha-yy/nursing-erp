# nursing-erp 环境变量模板（复制为 .env 后填写，.env 已 gitignore 不提交）

# ERP API 认证密钥（P0 安全加固 2026-08-21）
# /api/ 需携带请求头 X-API-Key: <此值>，或已登录的 Django session
# 调用方：ai-nursing-home 的 infra/.env 里配同名值 NURSING_ERP_API_KEY
ERP_API_KEY=

# Baidu OCR 服务（dl-ocr，菜单/点餐 OCR 用）
DL_OCR_URL=http://192.168.10.247:18080
DL_OCR_API_TOKEN=

# DeepSeek LLM（OCR 结果结构化纠错用）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Django
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=admin.eldcare.cn,localhost,127.0.0.1,dato-caddy
CSRF_TRUSTED_ORIGINS=https://admin.eldcare.cn:8443

# 数据库：设置 DB_PASSWORD 则启用 PostgreSQL，否则用 SQLite
DB_PASSWORD=
DB_HOST=nursing-db
DB_NAME=nursing_erp
DB_USER=nursing
